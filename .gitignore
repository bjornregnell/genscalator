# scala-cli / Scala build artifacts
.scala-build/
.bsp/
.metals/
target/

# scalex's symbol index (a pure cache: every command auto-reindexes changed files, and `scalex index`
# force-rebuilds it). It lands in whatever directory is passed as -w, so this must match at ANY depth --
# which a pattern with no leading slash already does, exactly like .scala-build/ above. There is no
# repo-root config for scalex; it is configured by CLI flags alone, so nothing here needs preserving.
.scalex/

# editor / agent local config
.vscode/
.claude/

# in-repo scratch (preferred over /tmp so paths stay inside the trusted tree)
tmp/

# the assembled deployable SITE (deploy/buildsite.sc). Fully derivable in one command, and the whole
# point of it existing is that "is this generated?" has a one-word answer: it is untracked. It mirrors
# the DEPLOYED site rather than the repo, so `tt links check out` is a check of what readers actually
# get - which is why it finds 4 real defects where the repo check finds 10 mostly-by-design ones.
out/

# release build output: buildnative.sc --out lands per-platform binaries here, and the CI matrix
# does the same. ~41 MB each, fully derivable from a build, and published as release assets.
dist/

# the generated scaladoc api site (SM188): ~600 files, fully derivable in one
# deploy/deployttapi.sc run and deployed to the website rather than consumed from
# the repo -- tracking it would put a whole-site churn diff on every regeneration
docs/generated/api/

# experiment run backups / partial-result snapshots
*.bak

# ---> Scala
*.class
*.log

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*

# latex stuff
*.aux
*.fdb_latexmk
*fls
*.out
*.synctex*