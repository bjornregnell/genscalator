#!/usr/bin/env bash
# tt — "typed tools": launcher for the Scala agent toolbox, so tools run from ANY repo as ONE literal,
# statically-analyzable command:  tt <tool> <args...>
# Why: matches a precise allowlist (e.g. `Bash(tt text *)`) → no /tmp, no `..` traversal, no
# shell-variable in the gated command (all of which force manual confirmation). Canonical copy lives
# here in the repo; ~/.local/bin/tt is typically a symlink to it.
set -euo pipefail
# Self-locate: TOOLS = the dir this script really lives in (follow symlinks), so tt works from ANY
# clone/install with no hardcoded path. Override with TT_TOOLS if the tools live elsewhere.
SOURCE="${BASH_SOURCE[0]}"
while [[ -L "$SOURCE" ]]; do
  DIR="$(cd -P "$(dirname "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
TOOLS="${TT_TOOLS:-$(cd -P "$(dirname "$SOURCE")" && pwd)}"
# Runnable verbs only (SM255 audit M2): a plain `ls *.scala` advertised 55 names of which 11
# were mainless helpers that fail with "no such tool". A verb is a file carrying @main;
# `dispatch` carries one too but IS the dispatcher, not a verb, so it is filtered by name.
# Deriving from @main (not a hardcoded helper list) keeps this line from drifting.
usage() {
  echo "usage: tt <tool> <args...>   (tools: $(cd "$TOOLS" && grep -l '@main' *.scala | sed 's/\.scala//' | grep -v '^dispatch$' | tr '\n' ' '))"
}
if [[ $# -lt 1 ]]; then
  usage
  exit 2
fi
tool="$1"; shift
# Help alias (issue 020): `tt help` is a newcomer's first guess (and the installer's closing
# instruction), so print the tool list and exit 0. Must sit BEFORE the guardrails below, which
# would otherwise reject '--help' as an invalid name and 'help' as a missing tool.
case "$tool" in
  help|--help|-h) usage; exit 0 ;;
  # Version alias (issue 028): answer "what are you?" without a JVM start. Same placement reason as
  # help above: the guardrail below rejects '--version'/'-v' before the file check. Restates the
  # cheap subset of tools/versionlib.scala (a native install has no tools/, so the paths cannot
  # share code). Display normalisation only: the carrier keeps its decided bare shape.
  version|--version|-v)
    root="$(cd -P "$TOOLS/.." && pwd)"
    v=""; [[ -f "$root/VERSION.txt" ]] && v="$(tr -d '[:space:]' < "$root/VERSION.txt")"
    [[ -n "$v" ]] || v="unknown"
    case "$v" in [0-9]*) v="v$v" ;; esac
    kind="source copy (plugin cache?)"; [[ -e "$root/.git" ]] && kind="git checkout"
    echo "genscalator $v ($kind at $root; bash launcher; $(uname -sm 2>/dev/null || true))"
    exit 0 ;;
esac
# Guardrail: tool must be a bare identifier (no '/', no '..') so we can only run TOOLS/<name>.scala.
[[ "$tool" =~ ^[a-zA-Z][a-zA-Z0-9_-]*$ ]] || { echo "tt: invalid tool name '$tool'"; exit 2; }
[[ -f "$TOOLS/$tool.scala" ]] || { echo "tt: no such tool '$tool' in $TOOLS"; exit 2; }
# Per-run timing (feedback kind b): time the whole invocation — note this is dominated by scala-cli/JVM
# startup+compile, NOT the tool logic — print a one-line summary to stderr (keeps stdout = tool output
# clean), and append to a perf log (gitignored tmp/ by default; override with TT_PERF_LOG). Opt out: TT_TIME=0.
# Native fast path (DEFAULT-ON since 2026-07-23; opt OUT with TT_NATIVE=0): run the
# native-image dispatcher binary instead of scala-cli when it exists AND no tools/**.scala
# is newer than it — a stale binary would silently run old tool behaviour, so staleness
# falls back to scala-cli with a stderr note (degrades to slow, never to wrong). Refresh
# via the ritual: scala-cli run deploy/buildnative.sc (build -> parity -> atomic swap).
# Binary: $TOOLS/../tmp/tt-native (override: TT_NATIVE_BIN). Details: docs/native.md.
runner=(scala-cli run "$TOOLS/$tool.scala" --java-prop "tt.tools=$TOOLS" --)
if [[ "${TT_NATIVE:-1}" == "1" ]]; then
  bin="${TT_NATIVE_BIN:-$TOOLS/../tmp/tt-native}"
  if [[ -x "$bin" ]]; then
    if [[ -z "$(find "$TOOLS" -name '*.scala' -newer "$bin" -print -quit)" ]]; then
      runner=("$bin" "-Dtt.tools=$TOOLS" "$tool")
    else
      # Wording matters more than it looks (SM252): read as a warning ABOUT THE TOOLBOX, this line led an
      # agent to conclude "tt is unusable" from one slow call and fall back to raw grep for an hour. It is
      # a note about SPEED, so it says so - the same "degrades to slow, never to wrong" the comment above
      # states. Keep the reassurance ahead of the remedy.
      echo "tt: native binary is stale (tools/ edited since build) - using scala-cli: SLOWER, still correct. Refresh when convenient: scala-cli run deploy/buildnative.sc" >&2
    fi
  fi
  # no binary at all = not graalified yet: silently use scala-cli (the pre-native default)
fi
start=$(date +%s%N)
set +e
"${runner[@]}" "$@"
rc=$?
set -e
if [[ "${TT_TIME:-1}" != "0" ]]; then
  ms=$(( ($(date +%s%N) - start) / 1000000 ))
  printf 'tt %s: %d.%03ds\n' "$tool" $((ms / 1000)) $((ms % 1000)) >&2
  log="${TT_PERF_LOG:-$TOOLS/../tmp/tt-perf.tsv}"
  { mkdir -p "$(dirname "$log")" && printf '%s\t%s\t%d\t%s\n' \
      "$(date '+%Y-%m-%d %H:%M:%S')" "$tool" "$ms" "$*" >> "$log"; } 2>/dev/null || true
fi
exit $rc
